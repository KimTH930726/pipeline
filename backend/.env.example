# ============================================================
# Agentic Deployment Portal - 환경 변수 설정
#
# 이 파일을 pipeline/ 루트에 .env로 복사하여 사용하세요:
#   cp backend/.env.example .env
#
# .env 파일은 .gitignore에 포함되어 Git에 올라가지 않습니다.
# ============================================================

# ─── 필수 설정 ─────────────────────────────────────────────

# Git 레포 호스트 경로 (docker-compose 볼륨 마운트에 사용)
# - 로컬:   D:/personalPJT/SMAgentLab
# - 서버:   /srv/repos/SMAgentLab.git (bare repo) 또는 /home/deploy/SMAgentLab
REPO_HOST_PATH=/srv/repos/SMAgentLab.git

# 배포 대상 프로젝트 호스트 경로
# - 이 경로가 docker-compose.yml에서 /deploy-target으로 마운트됨
# - 동시에 docker compose restart 실행 시 compose 파일 위치로도 사용
# - 반드시 호스트 절대 경로 (Docker 소켓 공유 방식이라 호스트 기준)
# - 로컬:   D:/personalPJT/SMAgentLab
# - 서버:   /home/deploy/SMAgentLab
DEPLOY_TARGET_PATH=/home/deploy/SMAgentLab

# 토큰 암호화 키 (Fernet) — 향후 사용자 시크릿 저장 시 사용
FERNET_SECRET_KEY=생성한키를여기에붙여넣기

# JWT 서명 키 (운영 환경에서 반드시 변경)
JWT_SECRET_KEY=change-this-secret-key-in-production

# ─── 선택 설정 ─────────────────────────────────────────────

# 초기 관리자 비밀번호 (최초 기동 시 admin 계정 생성에 사용)
ADMIN_DEFAULT_PASSWORD=admin1234

# LLM (DevX Gateway, client_credentials OAuth2 + SSE streaming)
# - 1단계: AUTH_ENDPOINT에 client_id/secret 보내서 access_token 발급
# - 2단계: CHAT_ENDPOINT에 Bearer 토큰으로 요청 → SSE 응답
# - 시스템 단일 자격 (사용자별 등록 불필요)
LLM_AUTH_ENDPOINT=https://devx-gw.shinsegae-inc.com/api/v1/auth/token
LLM_CHAT_ENDPOINT=https://devx-gw.shinsegae-inc.com/api/v1/agent/chat
LLM_CLIENT_ID=
LLM_CLIENT_SECRET=
LLM_AGENT_CODE=playground
LLM_AGENT_ID=b6958377-73f2-4234-a49c-2aa878350a2e

# 배포 모드
# - restart: 폐쇄망 (소스 볼륨 마운트 → docker restart만으로 반영)
# - build:   인터넷 환경 (docker compose build + up)
DEPLOY_MODE=restart

# 배포 대상 docker-compose 파일명
DEPLOY_COMPOSE_FILE=docker-compose.yml

# 배포 대상 추가 compose 오버라이드 (콤마 구분)
# - 폐쇄망 prod 환경: docker-compose.prod.yml
# - 비어있으면 base compose만 사용
# - 예: DEPLOY_COMPOSE_OVERRIDES=docker-compose.prod.yml
DEPLOY_COMPOSE_OVERRIDES=

# 재기동할 서비스명 (비어있으면 전체)
DEPLOY_SERVICE_NAME=backend

# 팀원용 Git clone URL (시작 가이드 페이지에 표시)
GIT_CLONE_URL=ssh://user@서버IP/srv/repos/SMAgentLab.git

# 포탈 포트
PORTAL_PORT=8080
FRONTEND_PORT=3000

# CORS 허용 오리진
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# ─── 폐쇄망 운영 (prod 모드) 전용 ───────────────────────────
# 이미지 버전 태그 — docker-compose.prod.yml에서 ${IMAGE_TAG}로 사용
# 운영 환경에서는 :latest 대신 명시적 버전 권장 (롤백·멀티버전 보존)
# 예: v1.0, v1.1
IMAGE_TAG=latest
